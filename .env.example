# Django Environment Settings
DJANGO_SECRET_KEY=ahhe-secret-key-change-in-production-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
POSTGRES_DB=ahhe_db
POSTGRES_USER=ahhe_user
POSTGRES_PASSWORD=ahhe_password
DB_HOST=localhost
DB_PORT=5432

# Redis & Cache Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# External Service Keys (Placeholders)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
AWS_STORAGE_BUCKET_NAME=ahhe-media-bucket

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api/v1
